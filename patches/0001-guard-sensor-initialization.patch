diff --git a/tests/validity/custom.py b/tests/validity/custom.py
index c9e4f37..6969aca 100644
--- a/tests/validity/custom.py
+++ b/tests/validity/custom.py
@@ -1,5 +1,6 @@
 #!/usr/bin/python3

+import os
 import traceback
 import sys
 import gi
@@ -60,6 +61,17 @@ stored = d.list_prints_sync()
 print("listing done")
 assert len(stored) == 1

+# Our fprintd policy must refuse deletion without changing sensor records.
+os.environ['FP_T480_PRESERVE_PRINTS'] = '1'
+for delete in (lambda: d.delete_print_sync(p), d.clear_storage_sync):
+    try:
+        delete()
+    except GLib.Error as error:
+        assert error.matches(FPrint.DeviceError.quark(), FPrint.DeviceError.NOT_SUPPORTED)
+    else:
+        raise AssertionError('Preservation policy allowed deletion')
+assert len(d.list_prints_sync()) == 1
+
 # 4. Verify against the enrolled print
 print("verifying")
 assert d.get_finger_status() == FPrint.FingerStatusFlags.NONE
@@ -92,6 +104,8 @@ del deserialized_prints
 while not identified:
     ctx.iteration(True)

+del os.environ['FP_T480_PRESERVE_PRINTS']
+
 # 6. Delete the enrolled print
 print("deleting")
 d.delete_print_sync(p)
